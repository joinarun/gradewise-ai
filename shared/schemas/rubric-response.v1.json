{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "questions": {
      "minItems": 1,
      "maxItems": 60,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.()-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "referenceAnswer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxMarks": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1000,
            "multipleOf": 0.5
          },
          "criteria": {
            "minItems": 1,
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.()-]*$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "maxMarks": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 1000,
                  "multipleOf": 0.5
                },
                "partialCredit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "id",
                "description",
                "maxMarks",
                "partialCredit"
              ],
              "additionalProperties": false
            }
          },
          "alternatives": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          },
          "examples": {
            "type": "object",
            "properties": {
              "correct": {
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                }
              },
              "incorrect": {
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                }
              }
            },
            "required": [
              "correct",
              "incorrect"
            ],
            "additionalProperties": false
          },
          "constraints": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "required": [
          "id",
          "text",
          "referenceAnswer",
          "maxMarks",
          "criteria",
          "alternatives",
          "examples",
          "constraints"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "questions"
  ],
  "additionalProperties": false
}
