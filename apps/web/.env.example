# Firebase web app configuration. Never enter a Gemini Developer API key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
VITE_FIREBASE_CLOUD_MODEL=gemini-3.5-flash-lite
# Enable only for local development. Register the generated token privately.
VITE_FIREBASE_APPCHECK_DEBUG=false
